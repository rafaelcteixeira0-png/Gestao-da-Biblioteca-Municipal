{
  "name": "biblioteca-municipal-cianorte",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "api": "node --env-file-if-exists=.env server/start.mjs",
    "start": "node --env-file-if-exists=.env server/start.mjs",
    "library": "node --env-file-if-exists=.env server/cli.mjs",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "playwright test",
    "test:server": "node --test --test-isolation=none tests/library.test.mjs tests/auth.test.mjs tests/api.test.mjs tests/backup.test.mjs tests/cli.test.mjs tests/config.test.mjs",
    "check": "npm run format:check && npm run lint && npm run test:server && npm run test:demo && npm run build && npm test",
    "test:demo": "node --test --test-isolation=none tests/demo-client.test.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2"
  }
}

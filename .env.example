# Dados fictícios; nenhuma senha padrão. Este arquivo mantém o modo local.
LIBRARY_MODE=local
LIBRARY_DB_PATH=.library-data/library.sqlite
LIBRARY_HOST=127.0.0.1
LIBRARY_PORT=3001
LIBRARY_ORIGIN=http://localhost:3001
LIBRARY_COOKIE_SECURE=false
# Para Vite: LIBRARY_ORIGIN=http://127.0.0.1:5173.
# Credenciais e frases de backup são pedidas no terminal, sem eco.
#
# Perfil hospedado: copie deploy/.env.hosted.example e leia docs/HOSPEDAGEM.md.
# Não basta mudar o nome do perfil: exige servidor, volume e HTTPS reais.
# Exemplo comentado; substitua os domínios reservados .example:
# LIBRARY_MODE=hosted
# LIBRARY_HOST=0.0.0.0
# LIBRARY_PORT=3001
# LIBRARY_DB_PATH=/data/library.sqlite
# LIBRARY_ORIGIN=https://biblioteca.example
# LIBRARY_COOKIE_SECURE=true
# A origem deve ser exatamente a do frontend, sem caminho, query ou fragmento.
# No modo hosted, PORT é alternativa a LIBRARY_PORT; LIBRARY_PORT tem prioridade.
# Não coloque senhas neste arquivo nem versione o .env preenchido.
